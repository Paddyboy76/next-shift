{
  "displayName": "Next Shift Authorization Denial",
  "documentation": {
    "content": "Next Shift State Authority denied an authorization request. Principal: ${log.extracted_label.principal}. Capability: ${log.extracted_label.capability}. Reason: ${log.extracted_label.reason}.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "State Authority DENY",
      "conditionMatchedLog": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"next-shift-state-authority\" AND jsonPayload.event_type=\"authorization.decision\" AND jsonPayload.decision=\"DENY\"",
        "labelExtractors": {
          "principal": "EXTRACT(jsonPayload.principal)",
          "capability": "EXTRACT(jsonPayload.capability)",
          "reason": "EXTRACT(jsonPayload.reason)"
        }
      }
    }
  ],
  "combiner": "OR",
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    },
    "autoClose": "86400s"
  },
  "enabled": true
}
